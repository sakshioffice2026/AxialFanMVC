FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

// This is the BACKGROUND mesh only — a coarse box that snappyHexMesh
// will later refine around the actual blade STL (constant/triSurface/fan.stl,
// exported by the app's existing drawing/geometry generator). blockMesh
// does not know about blade geometry; it just needs to fully enclose it.

convertToMeters 1;

// __DOMAIN_RADIUS__ = fan tip radius * 3 (rule-of-thumb clearance so the
// MRF rotating zone and downstream wake are captured).
// __DOMAIN_LENGTH__ = fan tip radius * 4, split with the fan roughly
// 1/3 of the way from the inlet.
vertices
(
    (-__DOMAIN_RADIUS__ -__DOMAIN_RADIUS__ 0)
    ( __DOMAIN_RADIUS__ -__DOMAIN_RADIUS__ 0)
    ( __DOMAIN_RADIUS__  __DOMAIN_RADIUS__ 0)
    (-__DOMAIN_RADIUS__  __DOMAIN_RADIUS__ 0)
    (-__DOMAIN_RADIUS__ -__DOMAIN_RADIUS__ __DOMAIN_LENGTH__)
    ( __DOMAIN_RADIUS__ -__DOMAIN_RADIUS__ __DOMAIN_LENGTH__)
    ( __DOMAIN_RADIUS__  __DOMAIN_RADIUS__ __DOMAIN_LENGTH__)
    (-__DOMAIN_RADIUS__  __DOMAIN_RADIUS__ __DOMAIN_LENGTH__)
);

blocks
(
    // __MESH_DIVISIONS__ e.g. "40 40 60" — coarse; snappyHexMesh adds
    // the real resolution near the blade surface afterwards.
    hex (0 1 2 3 4 5 6 7) (__MESH_DIVISIONS__) simpleGrading (1 1 1)
);

edges ();

boundary
(
    inlet
    {
        type patch;
        faces ((0 1 2 3));
    }
    outlet
    {
        type patch;
        faces ((4 5 6 7));
    }
    sides
    {
        type patch;
        faces ((0 4 7 3) (1 5 4 0) (2 6 5 1) (3 7 6 2));
    }
);

mergePatchPairs ();
