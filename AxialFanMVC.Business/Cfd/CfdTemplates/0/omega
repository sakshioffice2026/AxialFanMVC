FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}

dimensions      [0 0 -1 0 0 0 0];

// __TI_OMEGA_INLET__ computed in C# from omega = sqrt(k) / (Cmu^0.25 * l),
// Cmu = 0.09, mixing length l = 0.07 * inlet duct diameter (2x tip
// radius) — standard duct-flow turbulence length-scale assumption.
internalField   uniform __TI_OMEGA_INLET__;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform __TI_OMEGA_INLET__;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform __TI_OMEGA_INLET__;
        value           uniform __TI_OMEGA_INLET__;
    }
    sides
    {
        type            slip;
    }
    "fan.*"
    {
        type            omegaWallFunction;
        value           uniform __TI_OMEGA_INLET__;
    }
}
