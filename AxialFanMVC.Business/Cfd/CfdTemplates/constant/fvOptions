FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvOptions;
}

// cellZone "__MRF_ZONE_NAME__" must exist — created by topoSet/snappyHexMesh
// cellZone selection around the blade STL before this file is read.
// Original design speed for traceability: __RPM_TARGET__ RPM.
// omega below is that same speed pre-converted to rad/s in C#
// (RPM * PI / 30) since OpenFOAM's MRFSource expects rad/s, not RPM.
MRFZone1
{
    type            MRFSource;
    active          true;
    selectionMode   cellZone;
    cellZone        __MRF_ZONE_NAME__;

    MRFSourceCoeffs
    {
        origin      (0 0 0);
        axis        (0 0 1);      // rotation axis == blockMesh z-axis
        omega       __OMEGA_RAD_S__;
    }
}
