FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      turbulenceProperties;
}

simulationType  RAS;

RAS
{
    // kOmegaSST: standard choice for blade/wall-bounded turbomachinery
    // flows — better near-wall + adverse-pressure-gradient behaviour on
    // the blade suction side than k-epsilon.
    RASModel        kOmegaSST;
    turbulence      on;
    printCoeffs     on;
}
