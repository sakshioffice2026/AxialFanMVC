@* {{!-- 3D Blade Viewer — real STL geometry generated from this design's
       own calculated numbers (see CfdController.BladeStl / BladeStlGenerator).
       Self-contained dark "premium" widget; doesn't touch the rest of the
       page's light theme. --}} *@
<div class="card shadow-sm mb-4 blade-viewer-card">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h5 class="card-title mb-0">
            <i class="bi bi-badge-3d me-2 text-info"></i>3D Blade Viewer
        </h5>
        <div class="btn-group btn-group-sm blade-viewer-toolbar" role="group" aria-label="Viewer controls">
            <button type="button" class="btn" id="bladeViewerReset" title="Reset view">
                <i class="bi bi-arrow-counterclockwise"></i> Reset View
            </button>
            <button type="button" class="btn" id="bladeViewerAutoFit" title="Auto fit">
                <i class="bi bi-aspect-ratio"></i> Auto Fit
            </button>
            <button type="button" class="btn" id="bladeViewerSpin" title="Play/pause rotation">
                <i class="bi bi-pause-fill" id="bladeViewerSpinIcon"></i> <span id="bladeViewerSpinLabel">Pause</span>
            </button>
            <button type="button" class="btn" id="bladeViewerFullscreen" title="Fullscreen">
                <i class="bi bi-fullscreen"></i> Fullscreen
            </button>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="blade-viewer-stage" id="bladeViewerStage">
            <span class="blade-viewer-badge">
                <i class="bi bi-info-circle me-1"></i>Geometry generated from this design's blade-element data
            </span>
            <div class="blade-viewer-overlay" id="bladeViewerOverlay">
                <div class="spinner-border text-info" role="status"></div>
                <span id="bladeViewerOverlayText">Loading blade geometry…</span>
            </div>
        </div>
    </div>
</div>

@* {{!-- Persistent CFD Result card — survives page refresh / revisit.
       Populated on initial load from Model.HasCfdResult (ResultsController
       checks wwwroot/cfd/{ResultId}/pressure_slice.png on disk), and kept
       in sync afterwards by updateCfdResultCard() whenever a run completes
       in the modal above, without touching the modal/polling logic itself. --}} *@
<div class="card shadow-sm mb-4" id="cfdResultCard">
    <div class="card-body" id="savedCfdBody" style="@(Model.HasCfdResult ? "" : "display:none;")">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <h5 class="card-title mb-0">
                <i class="bi bi-wind me-2 text-info"></i>CFD Pressure Slice
            </h5>
            <span class="badge bg-success" id="savedCfdStatus">Available</span>
        </div>
        <img id="savedCfdImage" src="@Model.CfdImageUrl" alt="Saved CFD static-pressure slice"
             class="img-fluid rounded border mb-2" style="max-height: 320px; object-fit: contain;" />
        <p class="text-muted small mb-3" id="savedCfdTime">
            @if (Model.CfdGeneratedOn.HasValue)
            {
                @:Generated @Model.CfdGeneratedOn.Value.ToString("dd MMM yyyy, HH:mm")
            }
        </p>
        <div class="d-flex gap-2 flex-wrap">
            <a id="savedCfdView" href="@Model.CfdImageUrl" target="_blank" class="btn btn-outline-info btn-sm">
                <i class="bi bi-arrows-fullscreen me-1"></i>View Full Size
            </a>
            <a id="savedCfdDownload" href="@Model.CfdImageUrl" download class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-download me-1"></i>Download PNG
            </a>
            <a id="savedCfdVtp" href="@Model.CfdVtpUrl" download class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-download me-1"></i>Download VTP
            </a>
            <button type="button" class="btn btn-outline-warning btn-sm" data-bs-toggle="modal" data-bs-target="#cfdModal">
                <i class="bi bi-arrow-clockwise me-1"></i>Run Again
            </button>
        </div>
    </div>
    <div class="card-body text-center py-4" id="savedCfdEmpty" style="@(Model.HasCfdResult ? "display:none;" : "")">
        <p class="text-muted mb-3">
            <i class="bi bi-wind me-2"></i>No CFD Result Available
        </p>
        <button type="button" class="btn btn-info btn-sm" data-bs-toggle="modal" data-bs-target="#cfdModal">
            <i class="bi bi-play-fill me-1"></i>Generate CFD
        </button>
    </div>
</div>

<div class="row g-4">

    <div class="col-lg-3">
        <div class="card shadow-sm">
            <div class="card-header bg-light fw-semibold">
                <i class="bi bi-input-cursor-text me-1 text-secondary"></i>Input Parameters
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <tbody>
                        <tr><td class="text-muted ps-3">Flow Rate</td><td class="fw-semibold">@Model.FlowRateM3s.ToString("F3") m³/s</td></tr>
                        <tr><td class="text-muted ps-3">Total Pressure</td><td class="fw-semibold">@Model.TotalPressurePa.ToString("F0") Pa</td></tr>
                        <tr><td class="text-muted ps-3">Speed</td><td class="fw-semibold">@Model.SpeedRpm RPM</td></tr>
                        <tr><td class="text-muted ps-3">Blade Count</td><td class="fw-semibold">@Model.BladeCount</td></tr>
                        <tr><td class="text-muted ps-3">Tip Diameter</td><td class="fw-semibold">@Model.TipDiameterMm.ToString("F0") mm</td></tr>
                        <tr><td class="text-muted ps-3">Blade Angle</td><td class="fw-semibold">@Model.BladeAngleDeg.ToString("F1") °</td></tr>
                        <tr><td class="text-muted ps-3">Blade Profile</td><td class="fw-semibold">@(Model.BladeProfileName ?? "—")</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-3">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white fw-semibold">
                <i class="bi bi-wind me-1"></i>Aerodynamic Results
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <tbody>
                        <tr><td class="text-muted ps-3">Specific Speed (Ω<sub>s</sub>)</td><td class="fw-semibold">@Model.SpecificSpeed.ToString("F4")</td></tr>
                        <tr><td class="text-muted ps-3">Tip Speed</td><td class="fw-semibold">@Model.TipSpeedMs.ToString("F2") m/s</td></tr>
                        <tr><td class="text-muted ps-3">Hub Diameter</td><td class="fw-semibold">@Model.HubDiameterMm.ToString("F1") mm</td></tr>
                        <tr><td class="text-muted ps-3">Blade Span</td><td class="fw-semibold">@Model.BladeSpanMm.ToString("F1") mm</td></tr>
                        <tr class="table-success"><td class="ps-3 fw-semibold">Overall Efficiency</td><td class="fw-bold text-success">@Model.OverallEfficiencyPct.ToString("F1") %</td></tr>
                        <tr class="table-primary"><td class="ps-3 fw-semibold">Shaft Power</td><td class="fw-bold">@Model.ShaftPowerKw.ToString("F3") kW</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-3">
        <div class="card shadow-sm">
            <div class="card-header bg-warning text-dark fw-semibold">
                <i class="bi bi-shield-check me-1"></i>Structural Results
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <tbody>
                        <tr><td class="text-muted ps-3">Material</td><td class="fw-semibold">Aluminium </td></tr>
                        <tr><td class="text-muted ps-3">Yield Strength</td><td class="fw-semibold">270 MPa</td></tr>
                        <tr><td class="text-muted ps-3">Tip Clearance</td><td class="fw-semibold">@Model.TipClearanceMm.ToString("F1") mm</td></tr>
                        <tr><td class="text-muted ps-3">Blade Stress</td><td class="fw-semibold">@Model.BladeStressMpa.ToString("F2") MPa</td></tr>
                        <tr>
                            <td class="ps-3 fw-semibold">Safety Factor</td>
                            <td>
                                @{
                                    var sfClass = Model.SafetyFactor >= 2.0 ? "text-success fw-bold" : "text-danger fw-bold";
                                }
                                <span class="@sfClass">@Model.SafetyFactor.ToString("F2")</span>
                                @if (Model.SafetyFactor >= 2.0)
                                {
                                    <i class="bi bi-check-circle text-success ms-1"></i>
                                }
                                else
                                {
                                    <i class="bi bi-exclamation-triangle text-danger ms-1"></i>
                                }
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div class="p-3">
                    <div class="d-flex justify-content-between small text-muted mb-1">
                        <span>Safety margin</span>
                        <span>Min: 2.0</span>
                    </div>
                    @{
                        var sfPct = Math.Min((Model.SafetyFactor / 4.0) * 100, 100);
                        var sfBarClass = Model.SafetyFactor >= 2.0 ? "bg-success" : "bg-danger";
                    }
                    <div class="progress" style="height: 12px;">
                        <div class="progress-bar @sfBarClass" style="width: @sfPct.ToString("F0")%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3">
        <div class="card shadow-sm">
            <div class="card-header bg-secondary text-white fw-semibold">
                <i class="bi bi-volume-up me-1"></i>Acoustic Results
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <tbody>
                        <tr>
                            <td class="text-muted ps-3">Overall Noise</td>
                            <td class="fw-semibold">@(Model.OverallNoiseDbA?.ToString("F1") ?? "—") dB(A)</td>
                        </tr>
                        <tr>
                            <td class="text-muted ps-3">Sound Power</td>
                            <td class="fw-semibold">@(Model.SoundPowerLevelDb?.ToString("F1") ?? "—") dB</td>
                        </tr>
                        <tr>
                            <td class="text-muted ps-3">Blade Passing Frequency</td>
                            <td class="fw-semibold">@(Model.BladePassingFrequencyHz?.ToString("F1") ?? "—") Hz</td>
                        </tr>
                        <tr>
                            <td class="text-muted ps-3">Tip Mach Number</td>
                            <td class="fw-semibold">@(Model.TipMachNumber?.ToString("F3") ?? "—")</td>
                        </tr>
                        <tr>
                            <td class="text-muted ps-3">Noise Rating</td>
                            <td class="fw-semibold">@Model.NoiseRating (@(Model.NoiseRatingValue?.ToString("F1") ?? "—"))</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
@if (Model.BaselineComparison != null && Model.PinnComparison != null)
{
    var pressureDiff = Model.PinnComparison.PressurePa - Model.BaselineComparison.PressurePa;
    var pressurePctValid = Math.Abs(Model.BaselineComparison.PressurePa) > 0.01;
    var pressurePct = pressurePctValid
    ? pressureDiff / Model.BaselineComparison.PressurePa * 100.0
    : 0.0;

    var effDiff = Model.PinnComparison.EfficiencyPct - Model.BaselineComparison.EfficiencyPct;
    var powerDiff = Model.PinnComparison.PowerKw - Model.BaselineComparison.PowerKw;

    @* Confirmation prompt — shown every time this page loads, before the
       comparison table below is revealed. Kept free of internal/technical
       terms (no "PINN", "Blade Element Theory", etc.) since this is
       user-facing copy, not an engineering log. *@
        <div class="modal fade" id="comparisonPromptModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Compare results?</h5>
                    </div>
                    <div class="modal-body">
                        Would you like to see this result compared against our auto-adjusted estimate?
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" id="comparisonPromptNo">No</button>
                        <button type="button" class="btn btn-primary" id="comparisonPromptYes">Yes</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 mt-4" id="comparisonCard" style="display:none;">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white fw-semibold">
                    <i class="bi bi-columns-gap me-2"></i>
                    Baseline vs Adjusted Estimate Comparison
                </div>

                <div class="card-body p-0">

                    <table class="table table-bordered table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width:30%">Parameter</th>
                                <th class="text-center text-primary">
                                    Standard Calculation
                                </th>
                                <th class="text-center text-danger">
                                    Adjusted Estimate
                                </th>
                                <th class="text-center">
                                    Difference
                                </th>
                            </tr>
                        </thead>
                        <tbody>

                            <tr>
                                <td>Total Pressure</td>

                                <td class="text-center">
                                    @Model.BaselineComparison.PressurePa.ToString("F1") Pa
                                </td>

                                <td class="text-center">
                                    @Model.PinnComparison.PressurePa.ToString("F1") Pa
                                </td>

                                <td class="text-center">
                                    @(pressureDiff >= 0 ? "+" : "")
                                    @pressureDiff.ToString("F1") Pa
                                    <br />
                                    <small class="text-muted">
                                        @(pressurePctValid ? $"({pressurePct:F2}%)" : "(baseline is 0 Pa — likely beyond this design's capability at the requested flow)")
                                    </small>
                                </td>
                            </tr>

                            <tr>
                                <td>Overall Efficiency</td>

                                <td class="text-center">
                                    @Model.BaselineComparison.EfficiencyPct.ToString("F2") %
                                </td>

                                <td class="text-center">
                                    @Model.PinnComparison.EfficiencyPct.ToString("F2") %
                                </td>

                                <td class="text-center">
                                    @(effDiff >= 0 ? "+" : "")
                                    @effDiff.ToString("F2") %
                                </td>
                            </tr>

                            <tr>
                                <td>Shaft Power</td>

                                <td class="text-center">
                                    @Model.BaselineComparison.PowerKw.ToString("F3") kW
                                </td>

                                <td class="text-center">
                                    @Model.PinnComparison.PowerKw.ToString("F3") kW
                                </td>

                                <td class="text-center">
                                    @(powerDiff >= 0 ? "+" : "")
                                    @powerDiff.ToString("F3") kW
                                </td>
                            </tr>

                            <tr>
                                <td>Peak Pressure</td>

                                <td class="text-center">
                                    @Model.BaselineComparison.PeakPressurePa.ToString("F1") Pa
                                </td>

                                <td class="text-center">
                                    @Model.PinnComparison.PeakPressurePa.ToString("F1") Pa
                                </td>

                                <td class="text-center">
                                    @((Model.PinnComparison.PeakPressurePa -
                                                                    Model.BaselineComparison.PeakPressurePa).ToString("F1")) Pa
                                                                                                                        </td>
                                                                                                                    </tr>

                            <tr>
                                <td>Peak Efficiency</td>

                                <td class="text-center">
                                    @Model.BaselineComparison.PeakEfficiencyPct.ToString("F2") %
                                </td>

                                <td class="text-center">
                                    @Model.PinnComparison.PeakEfficiencyPct.ToString("F2") %
                                </td>

                                <td class="text-center">
                                    @((Model.PinnComparison.PeakEfficiencyPct -
                                                                    Model.BaselineComparison.PeakEfficiencyPct).ToString("F2")) %
                            </td>
                        </tr>

                        </tbody>
                    </table>

                </div>



            </div>
        </div>
    }



@* {{!-- ── Flow Visualization (plain-language, non-mechanical audience) ── --}}
   Not a real CFD solve — no mesh, no Navier-Stokes solver. This is an
   illustrative animation driven by the real calculated values on this
   result (flow rate, pressure, RPM, efficiency) so a non-engineer can
   see, at a glance, what the numbers above actually mean physically. *@
    <div class="col-12">
        @{
            var fvPressurePa = Model.TotalPressurePa;
            var fvPressureBand = fvPressurePa < 250 ? "low" : fvPressurePa < 750 ? "medium" : "high";
            var fvPressureColor = fvPressureBand switch
            {
                "low" => "#5fb0e0",
                "medium" => "#f4a13a",
                _ => "#e0473c"
            };
            var fvPressureLabel = fvPressureBand switch
            {
                "low" => "Gentle push",
                "medium" => "Moderate push",
                _ => "Strong push"
            };

            // Purely illustrative timing, not physically scaled — just gives
            // the animation a "faster fan = faster spin/flow" feel.
            var fvSpinSeconds = Math.Clamp(3000.0 / Math.Max(Model.SpeedRpm, 1), 0.4, 3.0);
            var fvFlowSeconds = Math.Clamp(2.6 - (Model.FlowCoefficient * 3.0), 0.6, 2.6);
            var fvFlowM3h = Model.FlowRateM3s * 3600.0;
        }
        <div class="card shadow-sm">
            <div class="card-header bg-light fw-semibold d-flex justify-content-between align-items-center">
                <span>
                    <i class="bi bi-tornado me-1 text-primary"></i>
                    How Air Flows Through This Fan
                </span>
                <span class="badge bg-light text-muted border" data-bs-toggle="tooltip"
                      title="Illustrative diagram built from this design's calculated values — not a full 3D CFD simulation.">
                    <i class="bi bi-info-circle me-1"></i>Plain-language view
                </span>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">
                    This shows what the numbers above mean in practice: air enters on the left at normal
                    (ambient) pressure, the spinning fan pushes it through, and it leaves on the right faster
                    and at higher pressure — ready to move through your ducts, filters, or equipment.
                </p>

                <div class="flow-diagram-wrap">
                    <svg viewBox="0 0 900 260" class="flow-diagram-svg" role="img"
                         aria-label="Diagram of air entering the fan at ambient pressure and leaving at higher pressure and speed">
                        <defs>
                            <linearGradient id="fvOutGradient" x1="0" y1="0" x2="1" y2="0">
                                <stop offset="0%" stop-color="#a9d9f3" />
                                <stop offset="100%" stop-color="@fvPressureColor" />
                            </linearGradient>
                        </defs>

                        <!-- Inlet duct -->
                        <rect x="20" y="70" width="330" height="120" rx="10" fill="#dbeeff" stroke="#a9d0e8" />
                        <text x="185" y="55" text-anchor="middle" class="fv-label">Air In</text>
                        <text x="185" y="215" text-anchor="middle" class="fv-sublabel">Ambient pressure</text>

                        <!-- Outlet duct -->
                        <rect x="550" y="70" width="330" height="120" rx="10" fill="url(#fvOutGradient)" stroke="#c99" />
                        <text x="715" y="55" text-anchor="middle" class="fv-label">Air Out</text>
                        <text x="715" y="215" text-anchor="middle" class="fv-sublabel">
                            @fvPressureLabel &middot; @fvPressurePa.ToString("F0") Pa higher
                        </text>

                        <!-- Fan housing ring -->
                        <circle cx="450" cy="130" r="75" fill="#f4f6f8" stroke="#8a97a3" stroke-width="4" />

                        <!-- Spinning blade hub (illustrative, not to blade-count scale) -->
                        <g class="fv-rotor" style="animation-duration: @(fvSpinSeconds.ToString("F2"))s;">
                            <circle cx="450" cy="130" r="12" fill="#3b4a58" />
                            @for (int i = 0; i < 6; i++)
                            {
                                var angle = i * 60;
                                <rect x="447" y="60" width="6" height="60" rx="3" fill="#5b6b7a"
                                      transform="rotate(@angle 450 130)" />
                            }
                        </g>

                        <!-- Flow particles: inlet (slow, light) -->
                        <g class="fv-particles-in">
                            @for (int i = 0; i < 5; i++)
                            {
                                var cy = 95 + i * 15;
                                var delay = i * (fvFlowSeconds / 5.0);
                                <circle cy="@cy" r="4" fill="#5fa8d9" class="fv-dot-in"
                                        style="animation-duration: @(fvFlowSeconds.ToString("F2"))s; animation-delay: -@(delay.ToString("F2"))s;" />
                            }
                        </g>

                        <!-- Flow particles: outlet (faster, colored by pressure) -->
                        <g class="fv-particles-out">
                            @for (int i = 0; i < 7; i++)
                            {
                                var cy = 90 + i * 12;
                                var outSeconds = fvFlowSeconds * 0.55;
                                var delay = i * (outSeconds / 7.0);
                                <circle cy="@cy" r="4" fill="@fvPressureColor" class="fv-dot-out"
                                        style="animation-duration: @(outSeconds.ToString("F2"))s; animation-delay: -@(delay.ToString("F2"))s;" />
                            }
                        </g>
                    </svg>
                </div>

                <div class="row g-3 mt-1">
                    <div class="col-md-4">
                        <div class="border rounded p-3 h-100">
                            <div class="text-muted small">Air Moved</div>
                            <div class="fs-4 fw-bold">@Model.FlowRateM3s.ToString("F2") m&sup3;/s</div>
                            <div class="text-muted small">@fvFlowM3h.ToString("N0") m&sup3;/hour &mdash; how much air the fan pushes every second</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="border rounded p-3 h-100">
                            <div class="text-muted small">Pressure Added</div>
                            <div class="fs-4 fw-bold" style="color:@fvPressureColor">@Model.TotalPressurePa.ToString("F0") Pa</div>
                            <div class="text-muted small">The extra push needed to move air through ducts, filters, or coils</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="border rounded p-3 h-100">
                            <div class="text-muted small">Efficiency</div>
                            <div class="fs-4 fw-bold text-success">@Model.OverallEfficiencyPct.ToString("F1")%</div>
                            <div class="text-muted small">Share of motor power that becomes useful airflow; the rest is lost as heat and noise</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

