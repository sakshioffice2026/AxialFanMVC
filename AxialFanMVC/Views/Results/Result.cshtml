@* {{!-- Optimize for me — target-driven ML search, run against this
       project's most recent design constraints. See OptimizationController. --}} *@
        <div class="modal fade" id="optimizeModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-xl modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="bi bi-magic me-2 text-warning"></i>Optimize for me
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        @Html.AntiForgeryToken()

                        @* Idle state — explains what's about to happen, before the user commits *@
                        <div id="optimizeIdle">
                            <p class="text-muted mb-3">
                                This searches thousands of geometry combinations against your
                                current duty point and constraints (min efficiency, max noise,
                                max motor power, max tip diameter) and returns three candidate
                                designs — <strong>Budget</strong>, <strong>Silent</strong>, and
                                <strong>Premium</strong> — for you to compare against this result.
                                Usually takes under a minute.
                            </p>
                            <button type="button" class="btn btn-warning" id="optimizeStartBtn">
                                <i class="bi bi-play-fill me-1"></i>Start optimization
                            </button>
                        </div>

                        @* Running state *@
                        <div id="optimizeRunning" class="d-none text-center py-5">
                            <div class="spinner-border text-warning mb-3" role="status"></div>
                            <p class="mb-0 fw-semibold" id="optimizeStatusLabel">Queued…</p>
                            <small class="text-muted">This page will update automatically — no need to refresh.</small>
                        </div>

                        @* Error state *@
                        <div id="optimizeError" class="d-none alert alert-danger">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <span id="optimizeErrorMessage"></span>
                        </div>

                        @* Results state — filled in by JS from the candidates array *@
                        <div id="optimizeResults" class="d-none">
                            <div class="row g-3" id="optimizeCandidateRow"></div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <template id="optimizeCandidateTemplate">
            <div class="col-md-4">
                <div class="card h-100 border-2">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span class="fw-bold candidate-label"></span>
                        <span class="badge bg-secondary candidate-badge"></span>
                    </div>
                    <div class="card-body">
                        <table class="table table-sm mb-0">
                            <tbody>
                                <tr><td class="text-muted">Tip diameter</td><td class="text-end fw-semibold"><span class="candidate-tip"></span> mm</td></tr>
                                <tr><td class="text-muted">Hub ratio</td><td class="text-end fw-semibold candidate-hub"></td></tr>
                                <tr><td class="text-muted">Blade angle</td><td class="text-end fw-semibold"><span class="candidate-angle"></span>°</td></tr>
                                <tr><td class="text-muted">Blade count</td><td class="text-end fw-semibold candidate-count"></td></tr>
                                <tr><td class="text-muted">Speed</td><td class="text-end fw-semibold"><span class="candidate-rpm"></span> RPM</td></tr>
                                <tr><td class="text-muted">Blade profile</td><td class="text-end fw-semibold candidate-profile"></td></tr>
                                <tr class="table-active"><td class="text-muted">Efficiency</td><td class="text-end fw-semibold"><span class="candidate-eff"></span>%</td></tr>
                                <tr><td class="text-muted">Noise</td><td class="text-end fw-semibold"><span class="candidate-noise"></span> dBA</td></tr>
                                <tr><td class="text-muted">Cost</td><td class="text-end fw-semibold">₹<span class="candidate-cost"></span></td></tr>
                                <tr><td class="text-muted">Safety factor</td><td class="text-end fw-semibold candidate-safety"></td></tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="card-footer bg-transparent">
                        <button type="button" class="btn btn-outline-primary btn-sm w-100 candidate-copy-btn">
                            <i class="bi bi-clipboard me-1"></i>Copy geometry values
                        </button>
                    </div>
                </div>
            </div>
        </template>

@* {{!-- CFD pressure slice modal --}} *@
        <div class="modal fade" id="cfdModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="bi bi-wind me-2 text-info"></i>CFD pressure slice
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        @Html.AntiForgeryToken()

                        @* Idle state *@
                        <div id="cfdIdle">
                            <p class="text-muted mb-3">
                                Runs a local OpenFOAM simulation at this design's operating
                                point and renders a static-pressure cross-section through the
                                fan axis. This runs a real solver locally, so it can take a
                                few minutes depending on load.
                            </p>
                            <button type="button" class="btn btn-info" id="cfdStartBtn">
                                <i class="bi bi-play-fill me-1"></i>Run CFD
                            </button>
                        </div>

                        @* Running state *@
                        <div id="cfdRunning" class="d-none text-center py-5">
                            <div class="spinner-border text-info mb-3" role="status"></div>
                            <p class="mb-0 fw-semibold" id="cfdStatusLabel">Queued…</p>
                            <small class="text-muted d-block mb-3">This page will update automatically — no need to refresh.</small>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="cfdMinimizeBtn" data-bs-dismiss="modal">
                                <i class="bi bi-arrow-down-square me-1"></i>Minimize (notify me when done)
                            </button>
                            <small class="text-muted d-block mt-2">The solver keeps running in the background — you can close this window and keep working.</small>
                        </div>

                        @* Error state *@
                        <div id="cfdError" class="d-none alert alert-danger">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <pre id="cfdErrorMessage" class="mb-0 mt-2" style="white-space: pre-wrap; word-break: break-word; max-height: 300px; overflow-y: auto;"></pre>
                        </div>

                        @* Results state — filled in by JS once the job completes *@
                        <div id="cfdResults" class="d-none">
                            <img id="cfdResultImage" src="" alt="CFD static-pressure slice"
                                 class="img-fluid rounded border mb-3" />
                            <div class="d-flex gap-2">
                                <a id="cfdDownloadVtp" href="" download class="btn btn-outline-secondary btn-sm">
                                    <i class="bi bi-download me-1"></i>Download .vtp (ParaView)
                                </a>
                                <button type="button" class="btn btn-outline-info btn-sm" id="cfdRerunBtn">
                                    <i class="bi bi-arrow-clockwise me-1"></i>Run again
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

@section Scripts {
            <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/build/three.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/STLLoader.js"></script>
            <script>
                // ── Initial curve data from server ───────────────────────────
                const initialCurves = @Html.Raw(Model.CurveJson);
                const designAngle  = @Model.BladeAngleDeg;
                const designRpm    = @Model.SpeedRpm;
                const resultId     = @Model.ResultId;

                                // ── Comparison confirmation prompt ────────────────────────────
                        // Shown every time this page loads. Only fires when the comparison
                        // table actually exists for this result — no point prompting when
                        // there's nothing to show.
                        (function () {
                            const promptEl = document.getElementById('comparisonPromptModal');
                            const cardEl   = document.getElementById('comparisonCard');
                            if (!promptEl || !cardEl) return; // no comparison data for this result

                            const modal = new bootstrap.Modal(promptEl, { backdrop: 'static', keyboard: false });

                            document.getElementById('comparisonPromptYes').addEventListener('click', function () {
                                cardEl.style.display = '';
                                modal.hide();
                            });
                            document.getElementById('comparisonPromptNo').addEventListener('click', function () {
                                cardEl.style.display = 'none';
                                modal.hide();
                            });

                            modal.show();
                        })();

                // ── Design Assistant ────────────────────────────────────────────
                (function () {
                    const historyEl = document.getElementById('assistantHistory');
                    const inputEl   = document.getElementById('assistantInput');
                    const askBtn    = document.getElementById('assistantAsk');
                    if (!historyEl || !inputEl || !askBtn) return;

                    function appendMessage(role, text) {
                        const wrap = document.createElement('div');
                        wrap.className = 'mb-2';
                        const label = role === 'user' ? 'You' : 'Assistant';
                        const badgeClass = role === 'user' ? 'text-primary' : 'text-success';
                        wrap.innerHTML =
                            '<div class="small fw-bold ' + badgeClass + '">' + label + '</div>' +
                            '<div style="white-space:pre-wrap;">' + text + '</div>';
                        historyEl.appendChild(wrap);
                        historyEl.scrollTop = historyEl.scrollHeight;
                    }

                    async function ask() {
                        const message = inputEl.value.trim();
                        if (!message) return;

                        appendMessage('user', message);
                        inputEl.value = '';
                        askBtn.disabled = true;
                        appendMessage('assistant', 'Thinking...');
                        const thinkingEl = historyEl.lastElementChild;

                        try {
                            const resp = await fetch('/DesignAssistant/Ask', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ resultId: resultId, message: message })
                            });
                            const data = await resp.json();
                            thinkingEl.remove();
                            appendMessage('assistant', data.reply || 'No response.');
                        } catch (err) {
                            thinkingEl.remove();
                            appendMessage('assistant', 'Something went wrong reaching the assistant. Please try again.');
                        } finally {
                            askBtn.disabled = false;
                        }
                    }

                    askBtn.addEventListener('click', ask);
                    inputEl.addEventListener('keydown', function (e) {
                        if (e.key === 'Enter') { e.preventDefault(); ask(); }
                    });
                })();

                // ── 3D Blade Viewer ──────────────────────────────────────────────
                // Loads real STL geometry from /Cfd/BladeStl/{resultId} (generated
                // server-side by BladeStlGenerator from this design's own tip/hub
                // radius, blade count, RPM and axial velocity — see CfdController).
                // Self-contained: doesn't touch any other script block on this page.
                (function () {
                    const stageEl = document.getElementById('bladeViewerStage');
                    if (!stageEl || typeof THREE === 'undefined') return;

                    const overlayEl     = document.getElementById('bladeViewerOverlay');
                    const overlayTextEl = document.getElementById('bladeViewerOverlayText');
                    const btnReset      = document.getElementById('bladeViewerReset');
                    const btnAutoFit    = document.getElementById('bladeViewerAutoFit');
                    const btnSpin       = document.getElementById('bladeViewerSpin');
                    const btnSpinIcon   = document.getElementById('bladeViewerSpinIcon');
                    const btnSpinLabel  = document.getElementById('bladeViewerSpinLabel');
                    const btnFullscreen = document.getElementById('bladeViewerFullscreen');

                    // Same clamp formula as the flow-diagram SVG's fvSpinSeconds
                    // above, so "faster fan = faster spin" feels consistent
                    // between the plain-language diagram and this real geometry.
                    const spinSeconds = Math.min(Math.max(3000.0 / Math.max(designRpm, 1), 0.4), 3.0);
                    const angularVelocityRadPerSec = (2 * Math.PI) / spinSeconds;

                    const hubDiameterMm = @Model.HubDiameterMm;
                    const tipDiameterMm = @Model.TipDiameterMm;
                    // Scene units: metres, matching BladeStlGenerator's output.
                    const hubRadiusM = (hubDiameterMm / 2) / 1000;
                    const hubLengthM = Math.max((tipDiameterMm - hubDiameterMm) / 1000 * 0.35, hubRadiusM * 0.6);

                    let renderer, scene, camera, controls, clock;
                    let modelGroup = null;
                    let spinning = true;
                    let defaultCameraPos = null;
                    let resizeObserver = null;

                    function initScene() {
                        scene = new THREE.Scene();

                        camera = new THREE.PerspectiveCamera(45, stageEl.clientWidth / stageEl.clientHeight, 0.01, 100);

                        renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
                        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
                        renderer.setSize(stageEl.clientWidth, stageEl.clientHeight);
                        renderer.shadowMap.enabled = true;
                        renderer.shadowMap.type = THREE.PCFSoftShadowMap;
                        renderer.outputColorSpace = THREE.SRGBColorSpace || THREE.sRGBEncoding;
                        stageEl.appendChild(renderer.domElement);

                        // Lighting — key + fill + soft ambient, all shadow-casting
                        // where relevant, for a "premium" rendered look rather
                        // than flat/unlit geometry.
                        scene.add(new THREE.AmbientLight(0x8899aa, 0.55));

                        const keyLight = new THREE.DirectionalLight(0xffffff, 1.15);
                        keyLight.position.set(1.4, 1.8, 1.1);
                        keyLight.castShadow = true;
                        keyLight.shadow.mapSize.set(1024, 1024);
                        keyLight.shadow.camera.near = 0.05;
                        keyLight.shadow.camera.far = 10;
                        scene.add(keyLight);

                        const fillLight = new THREE.DirectionalLight(0x6fa8dc, 0.4);
                        fillLight.position.set(-1.2, -0.6, -0.8);
                        scene.add(fillLight);

                        const rimLight = new THREE.PointLight(0x66ccff, 0.5, 8);
                        rimLight.position.set(0, 1.2, -1.4);
                        scene.add(rimLight);

                        // Grid + axes helpers, sized relative to the fan geometry.
                        const gridSize = Math.max((tipDiameterMm / 1000) * 3, 0.6);
                        const grid = new THREE.GridHelper(gridSize, 20, 0x2c3a4a, 0x1a222c);
                        grid.position.y = -(tipDiameterMm / 2000) * 1.05;
                        scene.add(grid);

                        const axes = new THREE.AxesHelper(Math.max(tipDiameterMm / 2000, 0.2));
                        scene.add(axes);

                        controls = new THREE.OrbitControls(camera, renderer.domElement);
                        controls.enableDamping = true;
                        controls.dampingFactor = 0.08;
                        controls.minDistance = Math.max(tipDiameterMm / 2000, 0.1) * 0.6;
                        controls.maxDistance = Math.max(tipDiameterMm / 1000, 0.5) * 12;
                        controls.enablePan = true;
                        controls.enableZoom = true;
                        controls.enableRotate = true;
                        controls.screenSpacePanning = true;

                        modelGroup = new THREE.Group();
                        // BladeStlGenerator builds blades with eZ (0,0,1) as the
                        // rotation axis; rotate the whole group so that axis
                        // reads as "up-ish"/forward in a natural viewing pose,
                        // matching the axial-fan convention (looking down the bore).
                        modelGroup.rotation.x = -0.35;
                        scene.add(modelGroup);

                        // Hub cylinder, sized from this result's own
                        // HubDiameterMm/TipDiameterMm — illustrative shaft/hub
                        // volume the blades attach to, since BladeStlGenerator
                        // doesn't model a solid hub itself (see its docstring).
                        const hubGeometry = new THREE.CylinderGeometry(hubRadiusM, hubRadiusM, hubLengthM, 32);
                        hubGeometry.rotateX(Math.PI / 2); // align cylinder axis with Z (eZ)
                        const hubMaterial = new THREE.MeshStandardMaterial({
                            color: 0x4a5a6c, metalness: 0.55, roughness: 0.35
                        });
                        const hubMesh = new THREE.Mesh(hubGeometry, hubMaterial);
                        hubMesh.castShadow = true;
                        hubMesh.receiveShadow = true;
                        modelGroup.add(hubMesh);

                        clock = new THREE.Clock();

                        resizeObserver = new ResizeObserver(() => handleResize());
                        resizeObserver.observe(stageEl);

                        animate();
                    }

                    function handleResize() {
                        if (!renderer || !camera) return;
                        const w = stageEl.clientWidth;
                        const h = stageEl.clientHeight;
                        if (w === 0 || h === 0) return;
                        camera.aspect = w / h;
                        camera.updateProjectionMatrix();
                        renderer.setSize(w, h);
                    }

                    function animate() {
                        requestAnimationFrame(animate);
                        const delta = clock.getDelta();
                        if (spinning && modelGroup) {
                            modelGroup.rotateOnWorldAxis(new THREE.Vector3(0, 0, 1), angularVelocityRadPerSec * delta);
                        }
                        controls.update();
                        renderer.render(scene, camera);
                    }

                    function fitCameraToObject(object, offset) {
                        offset = offset || 1.6;
                        const box = new THREE.Box3().setFromObject(object);
                        const size = box.getSize(new THREE.Vector3());
                        const center = box.getCenter(new THREE.Vector3());

                        const maxDim = Math.max(size.x, size.y, size.z, 0.05);
                        const fov = camera.fov * (Math.PI / 180);
                        let distance = (maxDim / 2) / Math.tan(fov / 2);
                        distance *= offset;

                        const direction = new THREE.Vector3(0.6, 0.45, 1).normalize();
                        const newPos = center.clone().add(direction.multiplyScalar(distance));

                        camera.position.copy(newPos);
                        camera.near = Math.max(distance / 100, 0.01);
                        camera.far = distance * 100;
                        camera.updateProjectionMatrix();

                        controls.target.copy(center);
                        controls.update();

                        if (!defaultCameraPos) {
                            defaultCameraPos = { position: newPos.clone(), target: center.clone() };
                        }
                    }

                    function loadBladeStl() {
                        const loader = new THREE.STLLoader();
                        loader.load(
                            `/Cfd/BladeStl/${resultId}`,
                            (geometry) => {
                                geometry.computeVertexNormals();
                                geometry.computeBoundingBox();

                                const material = new THREE.MeshStandardMaterial({
                                    color: 0xb9c6d6,
                                    metalness: 0.65,
                                    roughness: 0.28,
                                    side: THREE.DoubleSide
                                });

                                const bladeMesh = new THREE.Mesh(geometry, material);
                                bladeMesh.castShadow = true;
                                bladeMesh.receiveShadow = true;
                                // STL coordinates are in metres already (BladeStlGenerator
                                // works directly in metres), no extra scaling needed.
                                modelGroup.add(bladeMesh);

                                fitCameraToObject(modelGroup);
                                overlayEl.classList.add('d-none');
                            },
                            undefined,
                            (err) => {
                                overlayTextEl.textContent = 'Could not load blade geometry.';
                                overlayEl.querySelector('.spinner-border')?.classList.add('d-none');
                                console.error('Blade STL load failed:', err);
                            }
                        );
                    }

                    // ── Toolbar ────────────────────────────────────────────────
                    btnReset?.addEventListener('click', () => {
                        if (!defaultCameraPos) return;
                        camera.position.copy(defaultCameraPos.position);
                        controls.target.copy(defaultCameraPos.target);
                        controls.update();
                    });

                    btnAutoFit?.addEventListener('click', () => {
                        if (modelGroup) fitCameraToObject(modelGroup);
                    });

                    btnSpin?.addEventListener('click', () => {
                        spinning = !spinning;
                        btnSpinIcon.className = spinning ? 'bi bi-pause-fill' : 'bi bi-play-fill';
                        btnSpinLabel.textContent = spinning ? 'Pause' : 'Play';
                    });

                    btnFullscreen?.addEventListener('click', () => {
                        if (!document.fullscreenElement) {
                            stageEl.requestFullscreen?.();
                        } else {
                            document.exitFullscreen?.();
                        }
                    });

                    stageEl.addEventListener('fullscreenchange', () => {
                        // Give the browser a frame to apply the fullscreen layout
                        // before resizing the renderer against it.
                        requestAnimationFrame(handleResize);
                    });

                    initScene();
                    loadBladeStl();
                })();

                const MAX_CURVES = 10;
                const COLOR_PALETTE = [
                    '#dc3545', // red
                    '#198754', // green
                    '#fd7e14', // orange
                    '#6f42c1', // purple
                    '#795548', // brown
                    '#d63384', // pink
                    '#20c997', // teal
                    '#212529', // black
                    '#0dcaf0', // cyan
                ];
                const MANUAL_COLOR_PALETTE = ['#6c757d', '#495057', '#adb5bd'];
                const DESIGN_COLOR = '#0d6efd'; // blue — reserved for the design curve only

                // Line weights tuned for a "premium" look: thin, crisp lines with
                // slightly larger hover points instead of chunky always-on markers.
                const DESIGN_LINE_WIDTH  = 2.25;
                const CURVE_LINE_WIDTH   = 1.5;
                const DESIGN_KW_WIDTH    = 1.5;
                const CURVE_KW_WIDTH     = 1;

                // ── Curve state ───────────────────────────────────────────────
                // Each curve: { id, label, angle, rpm, color, pinned, isDesign,
                //   temporary, origin ('System'|'Manual'), validationStatus
                //   ('ok'|'corrected'|'flagged'|'not_applicable'), flags (array,
                //   empty for Manual/'ok'), q, dp, eta, kw }
                let curves = [];

                if (initialCurves.baseline) {
                    curves.push({
                        id: "baseline",
                        label: "Baseline",
                        angle: designAngle,
                        rpm: designRpm,
                        color: "#0d6efd",
                        pinned: true,
                        isDesign: true,
                        temporary: false,
                        origin: "System",
                        validationStatus: initialCurves.baseline.validationStatus || "ok",
                        flags: initialCurves.baseline.flags || [],

                        q: initialCurves.baseline.q,
                        dp: initialCurves.baseline.dp,
                        eta: initialCurves.baseline.eta,
                        kw: initialCurves.baseline.kw
                    });
                }

                if (initialCurves.corrected) {
                    curves.push({
                        id: "pinn",
                        label: "Auto Corrected",
                        angle: designAngle,
                        rpm: designRpm,
                        color: "#dc3545",
                        pinned: true,
                        isDesign: false,
                        temporary: false,
                        origin: "System",
                        validationStatus: initialCurves.corrected.validationStatus || "ok",
                        flags: initialCurves.corrected.flags || [],

                        q: initialCurves.corrected.q,
                        dp: initialCurves.corrected.dp,
                        eta: initialCurves.corrected.eta,
                        kw: initialCurves.corrected.kw
                    });
                }

                // NEW — manually-entered curves (Feature 2)
                (initialCurves.manual || []).forEach((m, i) => {
                    curves.push({
                        id: "manual-" + m.id,
                        label: m.label || "Manual curve",
                        angle: designAngle,
                        rpm: designRpm,
                        color: MANUAL_COLOR_PALETTE[i % MANUAL_COLOR_PALETTE.length],
                        pinned: true,
                        isDesign: false,
                        temporary: false,
                        origin: "Manual",
                        validationStatus: "not_applicable",
                        flags: [],

                        q: m.q, dp: m.dp, eta: m.eta, kw: m.kw
                    });
                });

                let usedColors = new Set();
                function nextColor() {
                    const free = COLOR_PALETTE.find(c => !usedColors.has(c));
                    if (free) { usedColors.add(free); return free; }
                    return COLOR_PALETTE[curves.length % COLOR_PALETTE.length];
                }
                function nextManualColor() {
                    const usedManual = curves.filter(c => c.origin === 'Manual').length;
                    return MANUAL_COLOR_PALETTE[usedManual % MANUAL_COLOR_PALETTE.length];
                }
                function releaseColor(color) {
                    usedColors.delete(color);
                }

                // ── Chart.js setup (empty shells — populated by render()) ─────
                const commonScalesX = { title: { display: true, text: 'Flow Rate Q (m³/s)' } };

                const ctxQdp = document.getElementById('chartQdp').getContext('2d');
                const chartQdp = new Chart(ctxQdp, {
                    type: 'line',
                    data: { labels: [], datasets: [] },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: { display: false },
                            tooltip: { mode: 'index', intersect: false }
                        },
                        interaction: { mode: 'index', intersect: false },
                        scales: {
                            x: commonScalesX,
                            y: { title: { display: true, text: 'ΔP (Pa)' } }
                        }
                    }
                });

                const ctxEta = document.getElementById('chartEta').getContext('2d');
                const chartEta = new Chart(ctxEta, {
                    type: 'line',
                    data: { labels: [], datasets: [] },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: { display: false },
                            tooltip: { mode: 'index', intersect: false }
                        },
                        interaction: { mode: 'index', intersect: false },
                        scales: {
                            x: commonScalesX,
                            yEta: { type: 'linear', position: 'left', title: { display: true, text: 'η (%)' } },
                            yKw: { type: 'linear', position: 'right', title: { display: true, text: 'kW' }, grid: { drawOnChartArea: false } }
                        }
                    }
                });

                // Line style is decided purely by origin/role, per the plain-terms
                // rule: solid = primary system curve, dashed = other system
                // curves, dotted = manual/unverified. This must stay consistent
                // wherever a curve is drawn (both charts) so there's never a case
                // where the same curve looks "verified" in one place and not
                // the other.
                function lineDashFor(c) {
                    if (c.origin === 'Manual') return [2, 2];
                    if (c.isDesign) return [];
                    return [5, 3];
                }

                // ── Render everything from `curves` state ─────────────────────
                function render() {
                    // Nothing to show yet (no baseline/corrected/manual curves exist
                    // for this result) — bail out cleanly instead of crashing on
                    // reduce() with no elements to reduce. This happens for results
                    // that were calculated but never had GenerateCurve/Regenerate
                    // run against them yet.
                    if (curves.length === 0) {
                        chartQdp.data.labels = [];
                        chartQdp.data.datasets = [];
                        chartQdp.update();

                        chartEta.data.labels = [];
                        chartEta.data.datasets = [];
                        chartEta.update();

                        renderTable();
                        return;
                    }

                    const labelSource = curves.reduce((a, b) => (a.q.length >= b.q.length ? a : b));

                    chartQdp.data.labels = labelSource.q;
                    chartQdp.data.datasets = curves.map(c => ({
                        label: c.label,
                        data: c.dp,
                        borderColor: c.color,
                        backgroundColor: c.color + '12',
                        borderWidth: c.isDesign ? DESIGN_LINE_WIDTH : CURVE_LINE_WIDTH,
                        borderCapStyle: 'round',
                        borderJoinStyle: 'round',
                        borderDash: lineDashFor(c),
                        fill: c.isDesign,
                        tension: 0.35,
                        cubicInterpolationMode: 'monotone',
                        pointRadius: 0,
                        pointHoverRadius: c.isDesign ? 5 : 4,
                        pointHoverBackgroundColor: c.color,
                        pointHoverBorderColor: '#fff',
                        pointHoverBorderWidth: 2
                    }));
                    chartQdp.update();

                    chartEta.data.labels = labelSource.q;
                    chartEta.data.datasets = curves.flatMap(c => ([
                        {
                            label: `${c.label} — η`,
                            data: c.eta,
                            borderColor: c.color,
                            borderWidth: c.isDesign ? DESIGN_LINE_WIDTH : CURVE_LINE_WIDTH,
                            borderCapStyle: 'round',
                            borderJoinStyle: 'round',
                            borderDash: lineDashFor(c),
                            fill: false,
                            tension: 0.35,
                            cubicInterpolationMode: 'monotone',
                            pointRadius: 0,
                            pointHoverRadius: c.isDesign ? 5 : 4,
                            pointHoverBackgroundColor: c.color,
                            pointHoverBorderColor: '#fff',
                            pointHoverBorderWidth: 2,
                            yAxisID: 'yEta'
                        },
                        {
                            label: `${c.label} — kW`,
                            data: c.kw,
                            borderColor: c.color,
                            borderWidth: c.isDesign ? DESIGN_KW_WIDTH : CURVE_KW_WIDTH,
                            borderCapStyle: 'round',
                            borderJoinStyle: 'round',
                            borderDash: c.origin === 'Manual' ? [1, 2] : (c.isDesign ? [2, 2] : [1, 3]),
                            fill: false,
                            tension: 0.35,
                            cubicInterpolationMode: 'monotone',
                            pointRadius: 0,
                            pointHoverRadius: c.isDesign ? 4 : 3,
                            pointHoverBackgroundColor: c.color,
                            pointHoverBorderColor: '#fff',
                            pointHoverBorderWidth: 2,
                            yAxisID: 'yKw'
                        }
                    ]));
                    chartEta.update();

                    renderTable();
                }

                // Flag objects arrive with different casing depending on which server
                // path produced them (BuildCurveJson serializes raw PascalCase;
                // the GenerateCurve AJAX endpoint goes through Controller.Json(),
                // which camelCases by default) — read both until that's unified.
                function flagField(f, name) {
                    return f[name] ?? f[name.charAt(0).toLowerCase() + name.slice(1)];
                }

                // Escaped, newline-joined flag messages for a native title tooltip —
                // no Bootstrap popover component needed, so nothing to re-initialize
                // when rows are re-rendered via innerHTML.
                function flagsTooltip(flags) {
                    return (flags || [])
                        .map(f => `[${flagField(f, 'Severity') || ''}] ${flagField(f, 'Message') || ''}`)
                        .join('\n')
                        .replace(/"/g, '&quot;');
                }

                // ── Validation / origin badge — the single place this HTML is
                // generated, so the comparison table, PDF payload labels, and
                // any future surface all stay in sync with one definition. ──
                function validationBadge(c) {
                    if (c.origin === 'Manual') {
                        return '<span class="badge bg-secondary">✎ Manual — unverified</span>';
                    }

                    const hasFlags = c.flags && c.flags.length > 0;
                    const tooltip = hasFlags ? ` title="${flagsTooltip(c.flags)}"` : '';
                    const cursor = hasFlags ? ' style="cursor:help"' : '';

                    switch (c.validationStatus) {
                        case 'ok':
                            return '<span class="badge bg-success">✓ Validated</span>';
                        case 'corrected':
                            return `<span class="badge bg-warning text-dark"${tooltip}${cursor}>⚠ Auto-corrected${hasFlags ? ' ⓘ' : ''}</span>`;
                        case 'flagged':
                            return `<span class="badge bg-danger"${tooltip}${cursor}>⚠ Needs review${hasFlags ? ' ⓘ' : ''}</span>`;
                        default:
                            return '<span class="badge bg-light text-muted">—</span>';
                    }
                }

                function renderTable() {
                    const body = document.getElementById('curveCompareBody');
                    body.innerHTML = '';
                    curves.forEach(c => {
                        const tr = document.createElement('tr');

                        const swatchTd = document.createElement('td');
                        swatchTd.innerHTML = `<span style="display:inline-block;width:14px;height:14px;border-radius:3px;background:${c.color}"></span>`;
                        tr.appendChild(swatchTd);

                        const labelTd = document.createElement('td');
                        labelTd.className = c.isDesign ? 'fw-semibold' : '';
                        labelTd.textContent = c.label;
                        tr.appendChild(labelTd);

                        const angleTd = document.createElement('td');
                        angleTd.textContent = c.angle + '°';
                        tr.appendChild(angleTd);

                        const rpmTd = document.createElement('td');
                        rpmTd.textContent = c.rpm + ' RPM';
                        tr.appendChild(rpmTd);

                        const statusTd = document.createElement('td');
                        statusTd.innerHTML = validationBadge(c);
                        tr.appendChild(statusTd);

                        const pinTd = document.createElement('td');
                        if (c.isDesign) {
                            pinTd.innerHTML = `<span class="text-muted small">—</span>`;
                        } else {
                            const pinBtn = document.createElement('button');
                            pinBtn.type = 'button';
                            pinBtn.className = 'btn btn-sm ' + (c.pinned ? 'btn-primary' : 'btn-outline-secondary');
                            pinBtn.innerHTML = c.pinned ? '📌' : 'Pin';
                            pinBtn.title = c.pinned ? 'Unpin this curve' : 'Pin this curve (keeps it through Regenerate/Reset)';
                            pinBtn.addEventListener('click', () => togglePin(c.id));
                            pinTd.appendChild(pinBtn);
                        }
                        tr.appendChild(pinTd);

                        const removeTd = document.createElement('td');
                        if (!c.isDesign) {
                            const rmBtn = document.createElement('button');
                            rmBtn.type = 'button';
                            rmBtn.className = 'btn btn-sm btn-outline-danger';
                            rmBtn.innerHTML = '❌';
                            rmBtn.title = 'Remove this curve';
                            rmBtn.addEventListener('click', () => removeCurve(c.id));
                            removeTd.appendChild(rmBtn);
                        }
                        tr.appendChild(removeTd);

                        body.appendChild(tr);
                    });

                    document.getElementById('curveCountLabel').textContent = `${curves.length} / ${MAX_CURVES} curves`;

                    // Explicit "Pin Curve" button is only actionable when there's an
                    // unpinned, non-design curve currently on the chart to pin.
                    const pinnable = curves.some(c => !c.isDesign && !c.pinned);
                    const btnPin = document.getElementById('btnPinCurve');
                    btnPin.disabled = !pinnable;
                }

                function togglePin(id) {
                    const c = curves.find(x => x.id === id);
                    if (!c || c.isDesign) return;
                    c.pinned = !c.pinned;
                    c.temporary = false;
                    renderTable();
                }

                function removeCurve(id) {
                    const c = curves.find(x => x.id === id);
                    if (!c || c.isDesign) return;
                    curves = curves.filter(x => x.id !== id);
                    if (c.origin !== 'Manual') releaseColor(c.color);
                    render();
                }

                function addCurve(newCurveData, angle, rpm, label, origin, validationStatus, flags) {
                    origin = origin || 'System';
                    validationStatus = validationStatus || (origin === 'Manual' ? 'not_applicable' : 'ok');
                    flags = flags || [];

                    // Replace the current temporary (unpinned, non-design) curve if one
                    // exists, otherwise just append — this is what makes "change slider,
                    // Regenerate" swap only the latest unpinned curve while pinned ones
                    // stay put. Manual curves are never "temporary" so they're excluded.
                    const tempIndex = curves.findIndex(c => c.temporary && !c.pinned && !c.isDesign);
                    if (tempIndex !== -1) {
                        if (curves[tempIndex].origin !== 'Manual') releaseColor(curves[tempIndex].color);
                        curves.splice(tempIndex, 1);
                    }

                    let limitHit = false;
                    if (curves.length >= MAX_CURVES) {
                        const evictIndex = curves.findIndex(c => !c.pinned && !c.isDesign);
                        if (evictIndex !== -1) {
                            if (curves[evictIndex].origin !== 'Manual') releaseColor(curves[evictIndex].color);
                            curves.splice(evictIndex, 1);
                            limitHit = true;
                        } else {
                            document.getElementById('curveLimitAlert').textContent =
                                'Maximum of 10 comparison curves reached and all are pinned — unpin one to add another.';
                            document.getElementById('curveLimitAlert').classList.remove('d-none');
                            return;
                        }
                    }

                    const color = origin === 'Manual' ? nextManualColor() : nextColor();
                    curves.push({
                        id: 'curve-' + Date.now(),
                        label: label,
                        angle, rpm, color,
                        pinned: origin === 'Manual', // manual entries are pinned by default, same as before
                        isDesign: false,
                        temporary: origin !== 'Manual',
                        origin, validationStatus, flags,
                        q: newCurveData.q, dp: newCurveData.dp, eta: newCurveData.eta, kw: newCurveData.kw
                    });

                    const limitAlert = document.getElementById('curveLimitAlert');
                    if (limitHit) {
                        limitAlert.textContent = 'Maximum of 10 comparison curves reached — oldest unpinned curve was removed automatically.';
                        limitAlert.classList.remove('d-none');
                    } else {
                        limitAlert.classList.add('d-none');
                    }

                    render();
                }

                // ── Slider event listeners ────────────────────────────────────
                const sliderAngle  = document.getElementById('sliderAngle');
                const sliderRpm    = document.getElementById('sliderRpm');
                const labelAngle   = document.getElementById('labelAngle');
                const labelRpm     = document.getElementById('labelRpm');
                const displayAngle = document.getElementById('displayAngle');
                const displayRpm   = document.getElementById('displayRpm');
                const displayStatus= document.getElementById('displayStatus');

                // Update labels live as slider moves
                sliderAngle.addEventListener('input', function () {
                    const val = parseFloat(this.value);
                    labelAngle.textContent   = val + ' °';
                    displayAngle.textContent = val + ' °';
                });

                sliderRpm.addEventListener('input', function () {
                    const val = parseInt(this.value);
                    labelRpm.textContent   = val + ' RPM';
                    displayRpm.textContent = val + ' RPM';
                });

                // ── Regenerate button ─────────────────────────────────────────
                document.getElementById('btnGenCurve')
                        .addEventListener('click', async () => {
                    const angle = parseFloat(sliderAngle.value);
                    const rpm   = parseInt(sliderRpm.value);

                    displayStatus.textContent = 'Generating...';
                    displayStatus.className   = 'fw-bold text-warning fs-5';

                    try {
                        const token = document.querySelector(
                            'input[name=__RequestVerificationToken]')?.value || '';

                        const resp = await fetch(
                            `/Results/GenerateCurve?resultId=${resultId}` +
                            `&bladeAngleDeg=${angle}&speedRpm=${rpm}`,
                            {
                                method: 'POST',
                                headers: { 'RequestVerificationToken': token }
                            }
                        );

                        if (resp.ok) {
                            const d = await resp.json();

                            addCurve(
                                { q: d.baseline.q, dp: d.baseline.dp, eta: d.baseline.eta, kw: d.baseline.kw },
                                angle, rpm, 'Baseline', 'System', d.baseline.validationStatus, d.baseline.flags
                            );

                            addCurve(
                                { q: d.corrected.q, dp: d.corrected.dp, eta: d.corrected.eta, kw: d.corrected.kw },
                                angle, rpm, 'Auto Corrected', 'System', d.corrected.validationStatus, d.corrected.flags
                            );

                            const anyFlagged =
                                (d.baseline.validationStatus === 'flagged') ||
                                (d.corrected.validationStatus === 'flagged');
                            const anyCorrected =
                                (d.baseline.validationStatus === 'corrected') ||
                                (d.corrected.validationStatus === 'corrected');

                            if (anyFlagged) {
                                displayStatus.textContent = '⚠ Needs review';
                                displayStatus.className   = 'fw-bold text-danger fs-5';
                            } else if (anyCorrected) {
                                displayStatus.textContent = '⚠ Auto-corrected';
                                displayStatus.className   = 'fw-bold text-warning fs-5';
                            } else {
                                displayStatus.textContent = '✓ Updated';
                                displayStatus.className   = 'fw-bold text-success fs-5';
                            }
                        } else {
                            displayStatus.textContent = '✗ Error';
                            displayStatus.className   =
                                'fw-bold text-danger fs-5';
                        }
                    } catch (e) {
                        displayStatus.textContent = '✗ Failed';
                        displayStatus.className   = 'fw-bold text-danger fs-5';
                    }
                });

                // ── Save Manual Curve (Feature 2) ─────────────────────────────
                document.getElementById('btnSaveManualCurve').addEventListener('click', async () => {
                    const parseList = s => s.split(',').map(v => parseFloat(v.trim())).filter(v => !isNaN(v));
                    const q   = parseList(document.getElementById('manualQ').value);
                    const dp  = parseList(document.getElementById('manualDp').value);
                    const eta = parseList(document.getElementById('manualEta').value);
                    const kw  = parseList(document.getElementById('manualKw').value);
                    const label = document.getElementById('manualLabel').value || 'Manual curve';

                    if (!(q.length === dp.length && q.length === eta.length && q.length === kw.length && q.length > 0)) {
                        alert('All four fields need the same number of comma-separated values.');
                        return;
                    }

                    const btn = document.getElementById('btnSaveManualCurve');
                    const originalHtml = btn.innerHTML;
                    btn.disabled = true;
                    btn.innerHTML = 'Saving...';

                    try {
                        const token = document.querySelector('input[name=__RequestVerificationToken]')?.value || '';
                        const resp = await fetch('/Results/SaveManualCurve', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                            body: JSON.stringify({
                                resultId, label,
                                bladeAngleDeg: designAngle, speedRpm: designRpm,
                                q, dp, eta, kw
                            })
                        });

                        if (!resp.ok) { alert('Could not save manual curve.'); return; }
                        const d = await resp.json();

                        addCurve(
                            { q: d.q, dp: d.dp, eta: d.eta, kw: d.kw },
                            designAngle, designRpm, d.label, 'Manual', 'not_applicable'
                        );

                        // Clear the form and collapse it
                        document.getElementById('manualLabel').value = '';
                        document.getElementById('manualQ').value = '';
                        document.getElementById('manualDp').value = '';
                        document.getElementById('manualEta').value = '';
                        document.getElementById('manualKw').value = '';
                        bootstrap.Collapse.getInstance(document.getElementById('manualCurveForm'))?.hide();
                    } catch (e) {
                        alert('Could not save manual curve: ' + e.message);
                    } finally {
                        btn.disabled = false;
                        btn.innerHTML = originalHtml;
                    }
                });

                // ── Pin Curve button — pins the most recently added unpinned curve ──
                document.getElementById('btnPinCurve').addEventListener('click', () => {
                    // Pin the latest unpinned, non-design curve (i.e. whatever is
                    // currently the "temporary" one from the last Regenerate).
                    const target = [...curves].reverse().find(c => !c.isDesign && !c.pinned);
                    if (!target) return;
                    target.pinned = true;
                    target.temporary = false;
                    renderTable();
                });

                // ── Reset to design point button ──────────────────────────────
                document.getElementById('btnResetCurve')
                        .addEventListener('click', () => {
                    sliderAngle.value        = designAngle;
                    sliderRpm.value          = designRpm;
                    labelAngle.textContent   = designAngle + ' °';
                    labelRpm.textContent     = designRpm + ' RPM';
                    displayAngle.textContent = designAngle + ' °';
                    displayRpm.textContent   = designRpm + ' RPM';

                    // Remove every curve except the original design curve (pinned or not).
                    // Manual curves are intentionally cleared too — Reset returns to the
                    // pure design-point view; manually-added curves can be re-added.
                    curves.filter(c => !c.isDesign).forEach(c => {
                        if (c.origin !== 'Manual') releaseColor(c.color);
                    });
                    curves = curves.filter(c => c.isDesign);

                    document.getElementById('curveLimitAlert').classList.add('d-none');

                    render();

                    displayStatus.textContent = 'Design Point';
                    displayStatus.className   = 'fw-bold text-primary fs-5';
                });

                // ── Initial render ──────────────────────────────────────────────
                render(); // also sets #btnPinCurve to disabled since only the design curve exists yet

                // ── Download PDF Summary — captures charts exactly as shown ────
                const btnDownloadPdf = document.getElementById('btnDownloadPdf');
                if (btnDownloadPdf) btnDownloadPdf.addEventListener('click', async (e) => {
                    e.preventDefault();
                    const link = e.currentTarget;
                    const originalHtml = link.innerHTML;
                    link.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Generating PDF...';

                    try {
                        const qdpImage = chartQdp.canvas.toDataURL('image/png', 1.0);
                        const etaImage = chartEta.canvas.toDataURL('image/png', 1.0);

                        // Only send the curve comparison rows if more than the design
                        // curve is on screen — otherwise there's nothing to compare.
                        // origin/validationStatus travel with each row so the PDF can
                        // label manual/auto-corrected/flagged curves the same way the
                        // on-screen table does.
                        const curvePayload = curves.length > 1
                            ? curves.map(c => ({
                                label: c.label,
                                angle: c.angle,
                                rpm: c.rpm,
                                color: c.color,
                                isDesign: c.isDesign,
                                origin: c.origin,
                                validationStatus: c.validationStatus
                            }))
                            : [];

                        const token = document.querySelector('input[name=__RequestVerificationToken]')?.value || '';

                        // FIX: this previously pointed at /Export/PdfWithCharts, which
                        // is commented out server-side and 404s. The live endpoint that
                        // does the same job is ChartsOnlyPdfWithSnapshot.
                        const resp = await fetch('/Export/ChartsOnlyPdfWithSnapshot', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': token
                            },
                            body: JSON.stringify({
                                resultId: resultId,
                                qdpImageBase64: qdpImage,
                                etaImageBase64: etaImage,
                                curves: curvePayload
                            })
                        });

                        if (!resp.ok) throw new Error(`Server returned ${resp.status}`);

                        const blob = await resp.blob();
                        const url = window.URL.createObjectURL(blob);
                        const a = document.createElement('a');
                        a.href = url;
                        a.download = `AxialFan_Result_${resultId}.pdf`;
                        document.body.appendChild(a);
                        a.click();
                        a.remove();
                        window.URL.revokeObjectURL(url);
                    } catch (err) {
                        alert('Could not generate PDF: ' + err.message);
                    } finally {
                        link.innerHTML = originalHtml;
                    }
                });

                // ── Optimize for me — event delegation, so it works no matter
                // when/how the modal HTML lands in the DOM. Nothing is looked
                // up until the moment it's actually needed.
                (function () {
                    const projectId = @Model.ProjectId;
                    const badgeByLabel = { Budget: 'bg-info', Silent: 'bg-primary', Premium: 'bg-dark' };
                    let pollTimer = null;

                    function q(id) { return document.getElementById(id); }

                    function showOnly(idToShow) {
                        ['optimizeIdle', 'optimizeRunning', 'optimizeError', 'optimizeResults'].forEach(id => {
                            const el = q(id);
                            if (el) el.classList.toggle('d-none', id !== idToShow);
                        });
                    }

                    function setStatusLabel(text) {
                        const el = q('optimizeStatusLabel');
                        if (el) el.textContent = text;
                    }

                    function setError(message) {
                        const el = q('optimizeErrorMessage');
                        if (el) el.textContent = message;
                        showOnly('optimizeError');
                    }

                    async function startOptimization() {
                        showOnly('optimizeRunning');
                        setStatusLabel('Queued…');
                        try {
                            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                            const res = await fetch(`/Optimization/Start?projectId=${projectId}`, {
                                method: 'POST',
                                headers: { 'RequestVerificationToken': token || '' }
                            });
                            if (!res.ok) {
                                const text = await res.text();
                                throw new Error(text || `Request failed (${res.status})`);
                            }
                            const data = await res.json();
                            pollStatus(data.jobId);
                        } catch (err) {
                            setError(err.message);
                        }
                    }

                    async function pollStatus(jobId) {
                        try {
                            const res = await fetch(`/Optimization/Status?jobId=${jobId}`);
                            if (!res.ok) throw new Error(`Status check failed (${res.status})`);
                            const data = await res.json();

                            if (data.status === 'Queued' || data.status === 'Running') {
                                setStatusLabel(data.status === 'Queued' ? 'Queued…' : 'Running — evaluating candidates…');
                                pollTimer = setTimeout(() => pollStatus(jobId), 3000);
                            } else if (data.status === 'Completed') {
                                renderCandidates(data.candidates || []);
                                showOnly('optimizeResults');
                            } else {
                                setError(data.errorMessage || 'Optimization failed for an unknown reason.');
                            }
                        } catch (err) {
                            setError(err.message);
                        }
                    }

                    function renderCandidates(candidates) {
                        const candidateRow = q('optimizeCandidateRow');
                        const template = q('optimizeCandidateTemplate');
                        if (!candidateRow || !template) {
                            console.error('Optimize for me: results container or template missing from DOM.');
                            return;
                        }
                        candidateRow.innerHTML = '';

                        // NOTE: OptimizeCandidateDto carries explicit [JsonPropertyName]
                        // snake_case attributes (to match optimizer_service.py's contract),
                        // and those override the app's default camelCase policy in BOTH
                        // directions — so this JSON comes back snake_case, not camelCase.
                        candidates.forEach(c => {
                            const node = template.content.cloneNode(true);
                            node.querySelector('.candidate-label').textContent = c.label;
                            const badge = node.querySelector('.candidate-badge');
                            badge.textContent = c.label;
                            badge.className = `badge ${badgeByLabel[c.label] || 'bg-secondary'} candidate-badge`;

                            node.querySelector('.candidate-tip').textContent = c.tip_diameter_mm.toFixed(0);
                            node.querySelector('.candidate-hub').textContent = c.hub_ratio.toFixed(2);
                            node.querySelector('.candidate-angle').textContent = c.blade_angle_deg.toFixed(1);
                            node.querySelector('.candidate-count').textContent = c.blade_count;
                            node.querySelector('.candidate-rpm').textContent = c.speed_rpm.toFixed(0);
                            node.querySelector('.candidate-profile').textContent = c.blade_profile;
                            node.querySelector('.candidate-eff').textContent = c.predicted_efficiency_pct.toFixed(1);
                            node.querySelector('.candidate-noise').textContent = c.predicted_noise_dba.toFixed(1);
                            node.querySelector('.candidate-cost').textContent = c.predicted_cost_total.toLocaleString('en-IN', { maximumFractionDigits: 0 });
                            node.querySelector('.candidate-safety').textContent = c.predicted_safety_factor.toFixed(2);

                            node.querySelector('.candidate-copy-btn').dataset.copyText = [
                                `Tip diameter: ${c.tip_diameter_mm.toFixed(0)} mm`,
                                `Hub ratio: ${c.hub_ratio.toFixed(2)}`,
                                `Blade angle: ${c.blade_angle_deg.toFixed(1)}°`,
                                `Blade count: ${c.blade_count}`,
                                `Speed: ${c.speed_rpm.toFixed(0)} RPM`,
                                `Blade profile: ${c.blade_profile}`
                            ].join('\n');

                            candidateRow.appendChild(node);
                        });
                    }

                    // Single delegated listener on document — handles clicks on
                    // #optimizeStartBtn and any .candidate-copy-btn, no matter
                    // when they were added to the page. This is what actually
                    // fixes "Start optimization not clickable": nothing is
                    // looked up (and nothing can be null) until the click itself.
                    document.addEventListener('click', function (e) {
                        if (e.target.closest('#optimizeStartBtn')) {
                            startOptimization();
                        }
                        const copyBtn = e.target.closest('.candidate-copy-btn');
                        if (copyBtn) {
                            navigator.clipboard.writeText(copyBtn.dataset.copyText || '');
                            const original = copyBtn.innerHTML;
                            copyBtn.innerHTML = '<i class="bi bi-check2 me-1"></i>Copied';
                            setTimeout(() => copyBtn.innerHTML = original, 1500);
                        }
                    });

                    const modalEl = q('optimizeModal');
                    if (modalEl) {
                        modalEl.addEventListener('show.bs.modal', () => {
                            if (pollTimer) clearTimeout(pollTimer);
                            showOnly('optimizeIdle');
                        });
                        modalEl.addEventListener('hidden.bs.modal', () => {
                            if (pollTimer) clearTimeout(pollTimer);
                        });
                    } else {
                        console.error('Optimize for me: #optimizeModal not found in DOM — the modal HTML block is missing from this page.');
                    }
                })();

                // ── CFD pressure slice — mirrors the Optimize for me flow above,
                // but polls /Cfd/Start and /Cfd/Status (see CfdController) and
                // shows an image instead of a candidate list.
                (function () {
                    let pollTimer = null;
                    // Tracks state across modal open/close so a minimized job
                    // isn't lost and doesn't restart from scratch on reopen.
                    let cfdJobInProgress = false;
                    let cfdCompletedData = null;

                    function q(id) { return document.getElementById(id); }

                    function showOnly(idToShow) {
                        ['cfdIdle', 'cfdRunning', 'cfdError', 'cfdResults'].forEach(id => {
                            const el = q(id);
                            if (el) el.classList.toggle('d-none', id !== idToShow);
                        });
                    }

                    function setStatusLabel(text) {
                        const el = q('cfdStatusLabel');
                        if (el) el.textContent = text;
                    }

                    function setError(message) {
                        const el = q('cfdErrorMessage');
                        if (el) el.textContent = message;
                        showOnly('cfdError');
                    }

                    function getToken() {
                        return document.querySelector('#cfdModal input[name="__RequestVerificationToken"]')?.value || '';
                    }

                    function requestNotifyPermission() {
                        if ('Notification' in window && Notification.permission === 'default') {
                            Notification.requestPermission();
                        }
                    }

                    function notifyDone(success) {
                        if (!('Notification' in window) || Notification.permission !== 'granted') return;
                        try {
                            new Notification(success ? 'CFD render completed successfully' : 'CFD render failed', {
                                body: success
                                    ? 'Your pressure slice for this design is ready to view.'
                                    : 'The CFD run failed — reopen this design to see details.',
                                icon: success ? undefined : undefined
                            });
                        } catch (e) { /* Notification not permitted/available — ignore, UI state still updates */ }
                    }

                    function populateResults(data) {
                        q('cfdResultImage').src = data.pngUrl || '';
                        const vtpLink = q('cfdDownloadVtp');
                        if (vtpLink) vtpLink.href = data.vtpUrl || '';
                    }

                    // Keeps the persistent CFD Result card (outside the modal,
                    // see cfdResultCard above) in sync the moment a run
                    // completes, so the user sees it right away instead of
                    // only after their next page load — without touching any
                    // polling/minimize/notification logic above.
                    function updateCfdResultCard(data) {
                        const img = q('savedCfdImage');
                        if (img) img.src = data.pngUrl || '';

                        const view = q('savedCfdView');
                        if (view) view.href = data.pngUrl || '';

                        const download = q('savedCfdDownload');
                        if (download) download.href = data.pngUrl || '';

                        const vtp = q('savedCfdVtp');
                        if (vtp) vtp.href = data.vtpUrl || '';

                        const status = q('savedCfdStatus');
                        if (status) status.textContent = 'Available';

                        const time = q('savedCfdTime');
                        if (time) time.textContent = 'Generated ' + new Date().toLocaleString();

                        const body = q('savedCfdBody');
                        if (body) body.style.display = '';
                        const empty = q('savedCfdEmpty');
                        if (empty) empty.style.display = 'none';
                    }

                    async function startCfd() {
                        cfdJobInProgress = true;
                        cfdCompletedData = null;
                        showOnly('cfdRunning');
                        setStatusLabel('Queued…');
                        try {
                            const res = await fetch(`/Cfd/Start?resultId=${resultId}`, {
                                method: 'POST',
                                headers: { 'RequestVerificationToken': getToken() }
                            });
                            if (!res.ok) {
                                const text = await res.text();
                                throw new Error(text || `Request failed (${res.status})`);
                            }
                            const data = await res.json();
                            pollStatus(data.jobId);
                        } catch (err) {
                            cfdJobInProgress = false;
                            setError(err.message);
                        }
                    }

                    async function pollStatus(jobId) {
                        try {
                            const res = await fetch(`/Cfd/Status?jobId=${jobId}`);
                            if (!res.ok) throw new Error(`Status check failed (${res.status})`);
                            const data = await res.json();

                            if (data.status === 'Queued' || data.status === 'Running') {
                                setStatusLabel(data.status === 'Queued' ? 'Queued…' : 'Running solver — this can take a few minutes…');
                                // Keep polling regardless of whether the modal is
                                // currently open — this is what lets the job keep
                                // being tracked after the user minimizes it.
                                pollTimer = setTimeout(() => pollStatus(jobId), 3000);
                            } else if (data.status === 'Completed') {
                                cfdJobInProgress = false;
                                cfdCompletedData = data;
                                populateResults(data);
                                updateCfdResultCard(data);
                                if (cfdModalEl.classList.contains('show')) {
                                    showOnly('cfdResults');
                                } else {
                                    notifyDone(true);
                                }
                            } else {
                                cfdJobInProgress = false;
                                const message = data.errorMessage || 'CFD run failed for an unknown reason.';
                                if (cfdModalEl.classList.contains('show')) {
                                    setError(message);
                                } else {
                                    notifyDone(false);
                                }
                            }
                        } catch (err) {
                            cfdJobInProgress = false;
                            if (cfdModalEl.classList.contains('show')) setError(err.message);
                        }
                    }

                    document.addEventListener('click', function (e) {
                        if (e.target.closest('#cfdStartBtn') || e.target.closest('#cfdRerunBtn')) {
                            requestNotifyPermission();
                            startCfd();
                        }
                        if (e.target.closest('#cfdMinimizeBtn')) {
                            requestNotifyPermission();
                        }
                    });

                    const cfdModalEl = q('cfdModal');
                    if (cfdModalEl) {
                        cfdModalEl.addEventListener('show.bs.modal', () => {
                            // Restore whatever state this job is actually in,
                            // instead of always resetting to the idle screen —
                            // otherwise reopening after a minimize looks like
                            // the job never ran.
                            if (cfdCompletedData) {
                                populateResults(cfdCompletedData);
                                showOnly('cfdResults');
                            } else if (cfdJobInProgress) {
                                showOnly('cfdRunning');
                            } else {
                                showOnly('cfdIdle');
                            }
                        });
                        cfdModalEl.addEventListener('hidden.bs.modal', () => {
                            // Intentionally NOT clearing pollTimer here anymore —
                            // the solver keeps running server-side regardless, and
                            // clearing this timer just meant the UI stopped
                            // noticing when it finished. Only cfdJobInProgress
                            // being false (job actually done/failed) stops polling now.
                        });
                    } else {
                        console.error('CFD pressure slice: #cfdModal not found in DOM — the modal HTML block is missing from this page.');
                    }
                })();
            </script>
}
