@model AxialFanMVC.ViewModels.DesignResultViewModel
@{
    ViewData["Title"] = $"Results — {Model.ProjectName}";
}

<style>
    /* ── Flow visualization diagram ───────────────────────────────── */
    .flow-diagram-wrap {
        width: 100%;
        max-width: 900px;
        margin: 0 auto;
    }

    .flow-diagram-svg {
        width: 100%;
        height: auto;
        display: block;
    }

    .fv-label {
        font-size: 18px;
        font-weight: 600;
        fill: #2c3e50;
    }

    .fv-sublabel {
        font-size: 13px;
        fill: #6c757d;
    }

    .fv-rotor {
        transform-origin: 450px 130px;
        animation-name: fv-spin;
        animation-timing-function: linear;
        animation-iteration-count: infinite;
    }

    @@keyframes fv-spin {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    .fv-dot-in {
        animation-name: fv-flow-in;
        animation-timing-function: linear;
        animation-iteration-count: infinite;
    }

    @@keyframes fv-flow-in {
        0% {
            transform: translateX(20px);
            opacity: 0;
        }

        10% {
            opacity: 1;
        }

        90% {
            opacity: 1;
        }

        100% {
            transform: translateX(370px);
            opacity: 0;
        }
    }

    .fv-dot-out {
        animation-name: fv-flow-out;
        animation-timing-function: linear;
        animation-iteration-count: infinite;
    }

    @@keyframes fv-flow-out {
        0% {
            transform: translateX(510px);
            opacity: 0;
        }

        10% {
            opacity: 1;
        }

        90% {
            opacity: 1;
        }

        100% {
            transform: translateX(870px);
            opacity: 0;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .fv-rotor, .fv-dot-in, .fv-dot-out {
            animation: none !important;
        }
    }

    /* ── 3D Blade Viewer ──────────────────────────────────────────── */
    .blade-viewer-card {
        background: #10151c;
        border: 1px solid #232b36;
        border-radius: 0.5rem;
        overflow: hidden;
    }

        .blade-viewer-card .card-header {
            background: #161d27;
            border-bottom: 1px solid #232b36;
            color: #e8edf3;
        }

    .blade-viewer-toolbar .btn {
        --bs-btn-color: #cfd8e3;
        --bs-btn-border-color: #2c3646;
        --bs-btn-hover-bg: #232e3d;
        --bs-btn-hover-color: #ffffff;
        --bs-btn-hover-border-color: #3a4759;
        --bs-btn-active-bg: #2c3646;
        background: #1a2129;
    }

    .blade-viewer-stage {
        position: relative;
        width: 100%;
        height: 480px;
        background: radial-gradient(circle at 50% 35%, #1b2430 0%, #0c1017 75%);
    }

        .blade-viewer-stage canvas {
            display: block;
            width: 100% !important;
            height: 100% !important;
            touch-action: none;
        }

        .blade-viewer-stage:fullscreen {
            height: 100vh;
        }

    .blade-viewer-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 0.75rem;
        color: #aab6c5;
        background: rgba(12, 16, 23, 0.85);
        pointer-events: none;
    }

        .blade-viewer-overlay.d-none {
            display: none !important;
        }

    .blade-viewer-badge {
        position: absolute;
        top: 0.75rem;
        left: 0.75rem;
        font-size: 0.72rem;
        letter-spacing: 0.04em;
        color: #8fa0b5;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 999px;
        padding: 0.2rem 0.65rem;
    }
</style>

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Projects" asp-action="Index">Projects</a>
            </li>
            <li class="breadcrumb-item">
                <a asp-controller="Design" asp-action="History"
                   asp-route-projectId="@Model.ProjectId">@Model.ProjectName</a>
            </li>
            <li class="breadcrumb-item active">Design Result #@Model.ResultId</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <h2 class="mb-1">
                <i class="bi bi-bar-chart-line me-2 text-primary"></i>Design Result
                @{
                    var (headerBadge, headerIcon) = Model.Status switch
                    {
                        "ok" => ("bg-success", "bi-check-circle-fill"),
                        "warning" => ("bg-warning text-dark", "bi-exclamation-triangle-fill"),
                        _ => ("bg-danger", "bi-x-circle-fill")
                    };
                }
                <span class="badge @headerBadge ms-2 fs-6">
                    <i class="bi @headerIcon me-1"></i>@Model.Status.ToUpper()
                </span>
            </h2>
            <small class="text-muted">
                Calculated @Model.CalculatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                &nbsp;|&nbsp; Result ID: #@Model.ResultId
            </small>
        </div>

        @* {{!-- Action Buttons --}} *@
        <div class="d-flex flex-wrap gap-2">
            @* {{!-- New Design --}} *@
            <a asp-controller="Design" asp-action="Wizard"
               asp-route-projectId="@Model.ProjectId"
               class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i>New Design
            </a>
            @* {{!-- Edit This Design --}} *@
            <a asp-controller="Design" asp-action="EditInput"
               asp-route-designInputId="@Model.DesignInputId"
               class="btn btn-outline-primary">
                <i class="bi bi-pencil me-1"></i>Edit
            </a>

            @* {{!-- View History --}} *@
            <a asp-controller="Design" asp-action="History"
               asp-route-projectId="@Model.ProjectId"
               class="btn btn-outline-secondary">
                <i class="bi bi-clock-history me-1"></i>History
            </a>

            @* {{!-- Optimize for me --}} *@
            <button type="button" class="btn btn-warning" id="optimizeForMeBtn"
                    data-bs-toggle="modal" data-bs-target="#optimizeModal">
                <i class="bi bi-magic me-1"></i>Optimize for me
            </button>

            @* {{!-- CFD pressure slice — runs the local OpenFOAM pipeline and
                   renders a pressure-field cross-section. See CfdController. --}} *@
            <button type="button" class="btn btn-outline-info" id="cfdBtn"
                    data-bs-toggle="modal" data-bs-target="#cfdModal">
                <i class="bi bi-wind me-1"></i>CFD pressure slice
            </button>

            @* {{!-- Export Dropdown --}} *@
            <div class="dropdown">
                <button class="btn btn-success dropdown-toggle"
                        type="button" data-bs-toggle="dropdown">
                    <i class="bi bi-download me-1"></i>Save / Export
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow">
                    <li>
                        <h6 class="dropdown-header">
                            <i class="bi bi-file-earmark me-1"></i>Export Options
                        </h6>
                    </li>
                    <li>
                        <a class="dropdown-item"
                           asp-controller="Export"
                           asp-action="Csv"
                           asp-route-resultId="@Model.ResultId">
                            <i class="bi bi-filetype-csv me-2 text-success"></i>
                            Export as CSV
                            <small class="text-muted d-block ps-4">
                                All data in spreadsheet format
                            </small>
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item"
                           asp-controller="Export"
                           asp-action="Report"
                           asp-route-resultId="@Model.ResultId">
                            <i class="bi bi-file-earmark-text me-2 text-primary"></i>
                            HTML Report
                            <small class="text-muted d-block ps-4">
                                Printable full design report
                            </small>
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item"
                           asp-controller="Export"
                           asp-action="Drawings"
                           asp-route-resultId="@Model.ResultId">
                            <i class="bi bi-rulers me-2 text-secondary"></i>
                            Engineering Drawings
                            <small class="text-muted d-block ps-4">
                                SVG technical drawings
                            </small>
                        </a>
                    </li>
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <a class="dropdown-item" href="#" onclick="window.print()">
                            <i class="bi bi-printer me-2 text-dark"></i>
                            Print This Page
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

